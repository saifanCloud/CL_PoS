{
  "name": "cl-pos-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Point of Sale (POS) system with Flutter and Node.js",
  "workspaces": [
    "apps/api",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "build:api": "npm run build --workspace=apps/api",
    "start:api": "npm run start --workspace=apps/api",
    "dev:pos": "flutter run --target=apps/pos_app/lib/main.dart",
    "lint": "npm run lint --workspaces --if-present",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "pos",
    "point-of-sale",
    "flutter",
    "nodejs",
    "typescript",
    "monorepo"
  ],
  "author": "",
  "license": "ISC"
}

